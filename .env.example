# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Bot Owner & Log Group IDs
OWNER_ID=
LOG_GROUP_ID=

# Telethon Userbot Credentials (my.telegram.org)
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_CHANNEL_ID=

# Telethon StringSession (Headless / GitHub Actions Login)
TELETHON_SESSION=

# On-Demand Cloudflare Worker Wake-on-Message (Optional - leave empty for 24/7 mode)
WORKER_URL=
WORKER_SECRET=
IDLE_TIMEOUT_SECONDS=300
MAX_RUN_SECONDS=5400

# Download and video limits
DOWNLOAD_DIR=downloads
MAX_FILE_SIZE_MB=2000
YOUTUBE_LONG_VIDEO_LIMIT=3
